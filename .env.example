# ==============================================================================
# Spark Configuration
# ==============================================================================
# Options: local, docker, k8s
SPARK_MODE=docker
# Temporary directory for Spark
SPARK_LOCAL_DIR=/tmp/spark  
# ==============================================================================
# Binance API Configuration
# ==============================================================================
WSS_ENDPOINT=wss://stream.binance.com:9443/ws
URL_TOP=https://api.binance.com/api/v3/ticker/24hr
# Limit number coin streaming each time 2 is recomment
LIMIT=2 
#STREAM_TYPES=trade,ticker,bookTicker
STREAM_TYPES=trade,ticker,bookTicker

# ==============================================================================
# Kafka Configuration
# ==============================================================================
BOOTSTRAP_SERVERS=bitnami-kafka:9092
#BOOTSTRAP_SERVERS=localhost:9093
BINANCE_TOPIC=binance
NUM_PARTITIONS=10
# SCHEMA_REGISTRY_URL=http://schema-registry:8081 # Uncomment if using Schema Registry

# Optional Kafka Log Retention Settings
KAFKA_LOG_RETENTION_MS=600000
KAFKA_LOG_RETENTION_BYTES=1000000000
KAFKA_LOG_SEGMENT_BYTES=100000000

# Kafka Configuration
KAFKA_NODE_ID=1
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_LISTENERS=PLAINTEXT://0.0.0.0:9092,CONTROLLER://0.0.0.0:9093
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT,CONTROLLER:PLAINTEXT
KAFKA_CONTROLLER_QUORUM_VOTERS=1@bitnami-kafka:9093
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://bitnami-kafka:9092
KAFKA_LOG_DIRS=/tmp/kraft-combined-logs
CLUSTER_ID=3Zms-h-xQdSl7YYrhvREeg
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
# ==============================================================================
# Kafka UI Configuration
# ==============================================================================
KAFKA_UI_CLUSTER_NAME=kraft-cluster
KAFKA_UI_BOOTSTRAP_SERVERS=bitnami-kafka:9092
KAFKA_UI_KAFKA_VERSION=3.5.0
# ==============================================================================
# AWS Credentials & Configuration
# ==============================================================================
AWS_ACCESS_KEY_ID=xxx-hidden
AWS_SECRET_ACCESS_KEY=xxx-hidden
AWS_DEFAULT_REGION=ap-southeast-1
BUCKET_NAME=binance-old-silver
ROOT_DB=trade,ticker,bookTicker
ATHENA_DB=binance 
S3_STAGING_DIR=s3://staging-binance-old-silver/ 

# ==============================================================================
# InfluxDB Configuration (for InfluxDB 2.x)
# ==============================================================================
INFLUXDB_URL=http://influxdb:8086 
#INFLUXDB_URL=http://localhost:8086
INFLUXDB_INIT_MODE=setup
INFLUXDB_INIT_USERNAME=admin
INFLUXDB_INIT_PASSWORD=xxx-hidden
INFLUXDB_ORG=THANH_TINH
INFLUXDB_BUCKET=realtime_crypto
INFLUXDB_TOKEN=xxx-hidden

# ==============================================================================
# Grafana Configuration
# ==============================================================================
GRAFANA_URL=http://grafana:3000
GRAFANA_DB_URL=http://influxdb:8086 
#GRAFANA_URL=http://localhost:3000
#GRAFANA_DB_URL=http://influxdb:8086 
GRAFANA_KEY=xxx-hidden
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=xxx-hidden

# ==============================================================================
# Apache Superset Configuration
# ==============================================================================
SUPERSET_URL=http://superset:8088
#SUPERSET_URL=http://localhost:8088
SUPERSET_USERNAME=admin
SUPERSET_PASSWORD=xxx-hidden
#EX: qIYVUmMBX8N8KvMxXr8R2G3d9vpzRZ4dltRrKogAjg==
SUPERSET_SECRET_KEY=xxx-hidden
SUPERSET_ADMIN_FIRSTNAME=Superset
SUPERSET_ADMIN_LASTNAME=Admin
SUPERSET_ADMIN_EMAIL=admin@superset.local
SUPERSET_RUN_HOST=0.0.0.0
SUPERSET_RUN_PORT=8088
# ==============================================================================
# Informer AI Configuration
# ==============================================================================
AI_APP_NAME=Informer_AI
# repartition number for Spark DataFrame
REPARTITION=12
# Ration of train:val:test for Trainer
TRAIN_RATIO=0.7
VAL_RATIO=0.2
# Number data (row) run each batch ; 64 or 128
BATCH_SIZE=64
# Max 7 day (s3 set 7 day data stored) but it just upper Limit range
N_DAYS_AGO=2
# Make sure create enough batch 2000-200000(1 dir ~ 1 min data) 
# Runable (tested) number is 180-300-100. (train time = 0:00 -> 0:50 )
MAX_DIRECTORIES=180
# SEQUENCE_LENGTH:PREDICTION_LENGTH = 3:1
SEQUENCE_LENGTH=300
# 1/3 of SEQUENCE_LENGTH
PREDICTION_LENGTH=100
# Number epoch, 200 will recomment, 20 was use to test
NUM_EPOCHS=20
# ==============================================================================
# AI Spark Configuration
# ==============================================================================
# Options: local, docker, k8s
AI_SPARK_MODE=docker
# Temporary directory for Spark
AI_SPARK_LOCAL_DIR=/tmp/ai-spark